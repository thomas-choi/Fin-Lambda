# .env.example -- committed template for Ops/fin-deep-data/.env
#
# serverless-dotenv-plugin (useDotenv: true) turns every key below into a Lambda
# environment variable at deploy time, so this file is both the local dry-run
# config and the deployed config. Copy it to .env and fill in the blanks.
#
# This service is standalone: it shares no .env with Ops/fin-cron-data. The DB
# credentials are the same ones, but the write targets deliberately are not --
# see EOD_WRITE_TBL / OPT_WRITE_TBL.

# --- database -------------------------------------------------------------
DBHOST=""
DBPORT="3306"
DBUSER=""
DBPWD=""
DBMKTDATA="GlobalMarketData"
DBTRADING="Trading"

# --- write targets (required, no fallback) --------------------------------
# *_shadow during the U5 shadow run; flipped to histdailyprice7 / OptionChains
# at the U6 cutover. A missing value fails the run at startup by design: a
# silent None would be interpolated into SQL as the string 'None'.
EOD_WRITE_TBL="histdailyprice7_shadow"
OPT_WRITE_TBL="OptionChains_shadow"
TBLLOADAUDIT="load_audit"
TBLCORPACTION="corp_action_daily"

# --- tables read or written by the v2 handlers and the status report -------
TBLDLYPRICE="histdailyprice7"
TBLOPTCHAIN="OptionChains"
TBLUSRATES="USRates"
TBLHISTFX="FX_histdaily"
TBLMINUTEPRICE="histminprice"
TBLPORTASSETS="portfolio_assets_info"

# --- symbol lists ---------------------------------------------------------
# eodDaily / optChainEOD: CALL GlobalMarketData.current_symbols_{SYMBOL_PROC_VER}
# V5 and later take an @type argument -- 'a' (all but delisted, eodDaily) or 'o'
# (optionable only, optChainEOD); V1-V4 take none and dataUtil withholds it, so
# this flips to "V5" the moment the owner has run
# Ops/fin-deep-data/sql/current_symbols_V5.sql. No code change goes with it.
SYMBOL_PROC_VER="V4"
# Intraday handlers. Keep this SET: the name only labels the output CSV -- the
# symbols always come from get_us_symbol / get_asia_symbol -- so leaving it unset
# makes the handler download the same list four times.
SYMBOLLIST="system"
# Directory holding stock_exchange.csv / Exchange_timezone.csv / intra_blacklist.csv.
# Leave empty: dataUtil.list_dir() then uses the packaged folder, which is right
# both on Lambda (/var/task) and in a local dry run.
PROD_LIST_DIR=""
# First date for a symbol with no rows. 2008/01/01 only after the plan's F6
# audit (G3) -- it is also the empty-table fallback of FXHistHandlerv2.
FIRSTTRAINDTE="2010/01/01"
# FX tickers, a Python list literal parsed with ast.literal_eval
FX_TICKERS="['HKD=X', 'CNY=X', 'EUR=X', 'JPY=X', 'GBP=X', 'TWD=X']"

# --- sharding / fan-out ---------------------------------------------------
EOD_SHARDS=1
EOD_BATCH=200
# OPT_SHARDS = ceil(T_total / 540 s), from the full-V4 timing dry run.
OPT_SHARDS=4
# reservedConcurrency of optChainEOD (caps parallel Yahoo traffic from Lambda)
OPT_MAX_PARALLEL=4

# --- Cloudflare R2 (S3-compatible) ---------------------------------------
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
UPSTREAM_R2_BUCKET=""
OPT_RAW_PREFIX="raw/optchain"
STATUS_R2_KEY="status/latest.json"

# --- statusReport ---------------------------------------------------------
# E-mail subscribed to the SNS topic declared in serverless.yml resources.
# Confirm the AWS subscription mail once, after the first deploy.
STATUS_EMAIL=""
# STATUS_TOPIC_ARN is injected by CloudFormation; do not set it here.

# --- portAssetsHandlerv2 --------------------------------------------------
SP500_PORT_NAME="SP500"
NDX100_PORT_NAME="NDX100"
DJIA_PORT_NAME="DJI"
HSI_PORT_NAME="HSI"
PORT_ASSET_CLASS="Equity"
PORT_ASSET_TYPE="Stock"
INDEX_CROSSCHECK="True"
# Where the verification CSVs go on Lambda (must be writable, i.e. under /tmp)
PORT_OUTPUT_DIR="/tmp"

# --- layer ARNs (versioned), from ./build_layers.sh + publish-layer-version ---
# No defaults on purpose: a wrong or stale layer deploys fine and then fails on
# the first import, at 18:30 ET, with nothing written.
FINDEEPCORE_LAYER_ARN=""
FINDEEPYF_LAYER_ARN=""
FINDEEPWEB_LAYER_ARN=""

# --- misc -----------------------------------------------------------------
# DEBUG="debug" raises the log level everywhere
DEBUG=""
